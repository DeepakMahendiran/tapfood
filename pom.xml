<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tap</groupId>
    <artifactId>tapfood</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <name>TapFood</name>
    <description>Food ordering web application built with Jakarta Servlet, JSP and MySQL</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
        <mysql.connector.version>9.2.0</mysql.connector.version>
        <jbcrypt.version>0.4</jbcrypt.version>
    </properties>

    <dependencies>

        <!--
            Servlet API. Scope is "provided" because Apache Tomcat 10.1 already
            ships Jakarta Servlet 6.0 on its own classpath. Bundling it inside the
            WAR would cause a ClassCastException / LinkageError at deployment time.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            MySQL JDBC driver. Scope is "runtime": the application code only talks
            to the java.sql API and loads the driver reflectively via
            Class.forName("com.mysql.cj.jdbc.Driver"), so it is never needed at
            compile time, but must be packaged into WEB-INF/lib.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.connector.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Password hashing (org.mindrot.jbcrypt.BCrypt). -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

    </dependencies>

    <build>
        <!-- Produces target/tapfood.war, which deploys under the /tapfood context path. -->
        <finalName>tapfood</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </build>

</project>
