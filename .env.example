# TapFood - environment variable template
#
# Copy this file to .env and fill in your own values, or set these as real
# environment variables for the Tomcat process (see README "Environment Variables").
#
# This file is committed to the repository on purpose. It contains NO real
# credentials - only placeholders. The actual .env file is git-ignored.

# JDBC connection string for the MySQL database.
DB_URL=jdbc:mysql://localhost:3306/Tapfood

# MySQL user that owns the Tapfood schema.
DB_USERNAME=your_username

# Password for that MySQL user.
DB_PASSWORD=your_password
